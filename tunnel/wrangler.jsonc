{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "personal-dashboard-relay",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  "durable_objects": {
    "bindings": [
      {
        "name": "HUB",
        "class_name": "Hub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Hub"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
